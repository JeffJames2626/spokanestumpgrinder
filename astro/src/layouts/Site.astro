---
// v2 layout (design system). Pages migrate from Base.astro (legacy) to this one as they're redesigned.
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/base.css';
import Seo from '../components/Seo.astro';
import Header from '../components/v2/Header.astro';
import Footer from '../components/v2/Footer.astro';
import MobileCtaBar from '../components/v2/MobileCtaBar.astro';
import RequestDialog from '../components/v2/RequestDialog.astro';

const { title, description, canonical, og, twitterCard, jsonld, active } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<Seo title={title} description={description} canonical={canonical} og={og} twitterCard={twitterCard} jsonld={jsonld} />
<link rel="icon" type="image/png" href="favicon.png">
<meta name="theme-color" content="#161616">
<link rel="preload" href="fonts/ibm-plex-sans-400.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="fonts/source-sans-3-700.woff2" as="font" type="font/woff2" crossorigin>
<script is:inline>
(function(){try{var t=localStorage.getItem('ssg-theme');if(t==='light'||t==='dark'){document.documentElement.setAttribute('data-theme',t);}}catch(e){}})();
</script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<Header active={active} />
<main id="main">
  <slot />
</main>
<Footer />
<MobileCtaBar />
<RequestDialog />
</body>
</html>
