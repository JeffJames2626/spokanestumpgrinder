---
// The service-request intake form as a modal window, available on every v2 page (included by Site.astro).
// Any element with [data-open-form] opens it; its href (service-request.html#request) is the no-JS /
// legacy-page fallback — that page opens the dialog on arrival when the hash is #request.
// Fields, copy and delivery config live in data/service-request.ts (see CLAUDE.md "Intake form").
import Icon from './Icon.astro';
import { form, options } from '../../data/service-request';
const configured = Boolean(form.action);
---
<dialog class="dialog" id="request" aria-labelledby="dialog-title">
  <div class="dialog-head">
    <div>
      <p class="eyebrow">Service request</p>
      <h2 id="dialog-title">Send us the details</h2>
      <p class="dialog-sub">We'll follow up with a written scope and price. No obligation.</p>
    </div>
    <button class="btn btn-ghost btn-icon dialog-close" type="button" data-close-form aria-label="Close the form"><Icon name="x" size={20} /></button>
  </div>
  <div class="dialog-body">
    {!configured && (
      <p class="notice" role="status">
        <Icon name="triangle-alert" size={18} /><span><strong>Delivery not set up yet.</strong> The form is built, but where submissions get emailed from hasn't been chosen — the button stays off until it is.</span>
      </p>
    )}

    <form id="intake" action={form.action || undefined} method={form.method} enctype="multipart/form-data" data-api={form.api}>
      {Object.entries(form.hidden).map(([k, v]) => <input type="hidden" name={k} value={v} />)}
      <input type="hidden" name="_next" id="next" value={form.nextDefault} />
      <p class="honey" aria-hidden="true"><label>Leave this field empty <input type="text" name={form.honeypot} tabindex="-1" autocomplete="off" /></label></p>

      <div class="form-section">
        <h3><span class="step-no">1</span> How to reach you</h3>
        <div class="form-grid">
          <div class="field">
            <label for="name">Name<span class="req" aria-hidden="true">*</span></label>
            <input class="input" id="name" name="Name" type="text" autocomplete="name" required />
            <span class="error">Please enter your name.</span>
          </div>
          <div class="field">
            <label for="phone">Phone<span class="req" aria-hidden="true">*</span></label>
            <input class="input" id="phone" name="Phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="509-555-0123" required minlength="7" />
            <span class="error">Please enter a phone number we can reach you at.</span>
          </div>
          <div class="field">
            <label for="email">Email<span class="req" aria-hidden="true">*</span></label>
            <input class="input" id="email" name="Email" type="email" autocomplete="email" inputmode="email" placeholder="you@example.com" required />
            <span class="error">That doesn't look like a valid email.</span>
          </div>
          <fieldset class="field">
            <legend>Best way to contact you</legend>
            <div class="choices inline">
              {options.contact.map((c, i) => (<label class="choice"><input type="radio" name="Preferred contact" value={c} checked={i === 0} /><strong>{c}</strong></label>))}
            </div>
          </fieldset>
        </div>
      </div>

      <div class="form-section">
        <h3><span class="step-no">2</span> Where the stump is</h3>
        <div class="form-grid">
          <div class="field span-2">
            <label for="street">Street address<span class="req" aria-hidden="true">*</span></label>
            <input class="input" id="street" name="Street address" type="text" autocomplete="street-address" required />
            <span class="error">We need the address to price access and travel.</span>
          </div>
          <div class="field">
            <label for="city">City<span class="req" aria-hidden="true">*</span></label>
            <input class="input" id="city" name="City" type="text" autocomplete="address-level2" required />
            <span class="error">Please enter the city.</span>
          </div>
          <div class="form-grid">
            <div class="field">
              <label for="state">State</label>
              <select class="select" id="state" name="State" autocomplete="address-level1">
                {options.states.map((s) => <option value={s}>{s}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="zip">ZIP</label>
              <input class="input" id="zip" name="ZIP" type="text" autocomplete="postal-code" inputmode="numeric" pattern="[0-9]{5}" placeholder="99202" />
              <span class="error">Five digits.</span>
            </div>
          </div>
        </div>
      </div>

      <div class="form-section">
        <h3><span class="step-no">3</span> About the stump</h3>
        <fieldset class="field">
          <legend>What do you need?<span class="req" aria-hidden="true">*</span></legend>
          <div class="choices">
            {options.service.map((s, i) => (<label class="choice"><input type="radio" name="Service" value={s.value} required checked={i === 0} /><span><strong>{s.label}</strong>{s.help}</span></label>))}
          </div>
        </fieldset>
        <div class="form-grid">
          <div class="field">
            <label for="count">How many stumps?</label>
            <input class="input" id="count" name="Number of stumps" type="number" inputmode="numeric" min="1" max="99" value="1" />
            <span class="hint">Several on one visit cost less each.</span>
          </div>
          <div class="field">
            <label for="diameter">Largest stump, across at ground level</label>
            <select class="select" id="diameter" name="Largest stump diameter">
              {options.diameter.map((d) => <option value={d}>{d}</option>)}
            </select>
            <span class="hint">Widest point at grade, not the old trunk.</span>
          </div>
          <div class="field">
            <label for="access">How do we get to it?</label>
            <select class="select" id="access" name="Access">
              {options.access.map((a) => <option value={a}>{a}</option>)}
            </select>
            <span class="hint">The gate opening decides which machine we bring.</span>
          </div>
          <div class="field">
            <label for="after">What's going in that spot afterward?</label>
            <select class="select" id="after" name="After the stump is gone">
              {options.after.map((a) => <option value={a}>{a}</option>)}
            </select>
            <span class="hint">Changes how deep we need to go.</span>
          </div>
        </div>
        <fieldset class="field">
          <legend>Anything nearby we should know about?</legend>
          <div class="choices inline">
            {options.nearby.map((n) => (<label class="choice"><input type="checkbox" name="Nearby" value={n} /><strong>{n}</strong></label>))}
          </div>
        </fieldset>
      </div>

      <div class="form-section">
        <h3><span class="step-no">4</span> Photos and notes</h3>
        <div class="field">
          <label for="photos">Photos of the stump <span class="hint">(optional, but they save a trip)</span></label>
          <input class="input" id="photos" name="Photos" type="file" accept="image/*" multiple />
          <span class="hint">One from a few feet back showing the path in, and one close-up with something for scale.</span>
        </div>
        <div class="field">
          <label for="notes">Anything else?</label>
          <textarea class="textarea" id="notes" name="Notes" rows="5" placeholder="Timing, questions, what's been tried already…"></textarea>
        </div>
        <div class="field">
          <label for="heard">How did you hear about us? <span class="hint">(optional)</span></label>
          <select class="select" id="heard" name="How did you hear about us">
            <option value="">Choose one</option>
            {options.heard.map((h) => <option value={h}>{h}</option>)}
          </select>
        </div>
      </div>

      <div class="form-foot">
        <div class="btn-row">
          <button class="btn btn-primary btn-lg btn-submit" type="submit" disabled={!configured}><Icon name="send" size={18} /> <span class="label">Send my request</span></button>
          <button class="btn btn-outline btn-lg" type="button" data-close-form>Cancel</button>
        </div>
        <p class="fine">We'll only use this to put together your estimate and get back to you. No spam, no sharing.</p>
      </div>
    </form>
  </div>
</dialog>

<script is:inline>
(function () {
  var dlg = document.getElementById('request'), form = document.getElementById('intake');
  if (!dlg || !form) return;
  // after FormSubmit's redirect the success card lives on service-request.html — always send people there
  var next = document.getElementById('next');
  if (next) next.value = location.origin + location.pathname.replace(/[^/]*$/, '') + 'service-request.html?sent=1';
  var open = function (e) {
    if (e) e.preventDefault();
    if (typeof dlg.showModal === 'function') { if (!dlg.open) dlg.showModal(); dlg.querySelector('.dialog-body').scrollTop = 0; }
    else dlg.setAttribute('open', '');
  };
  var close = function () { dlg.close ? dlg.close() : dlg.removeAttribute('open'); };
  document.querySelectorAll('[data-open-form]').forEach(function (b) { b.addEventListener('click', open); });
  document.querySelectorAll('[data-close-form]').forEach(function (b) { b.addEventListener('click', close); });
  dlg.addEventListener('click', function (e) { if (e.target === dlg) close(); }); // click on the backdrop
  var fromHash = function () { if (location.hash === '#request') { open(); try { history.replaceState(null, '', location.pathname + location.search); } catch (err) {} } };
  fromHash(); window.addEventListener('hashchange', fromHash);
  var sending = function (on) {
    form.classList.toggle('sending', on);
    var b = form.querySelector('.btn-submit'); if (b) { b.setAttribute('aria-busy', on ? 'true' : 'false'); b.querySelector('.label').textContent = on ? 'Sending…' : 'Send my request'; }
  };
  // Shrink a photo in the browser (max 1600px, JPEG) so the whole request stays small. Returns base64 or null.
  var shrink = function (file) {
    return new Promise(function (resolve) {
      if (!/^image\//.test(file.type)) return resolve(null);
      var img = new Image(), url = URL.createObjectURL(file);
      img.onload = function () {
        try {
          var max = 1600, w = img.naturalWidth, h = img.naturalHeight, k = Math.min(1, max / Math.max(w, h));
          var c = document.createElement('canvas'); c.width = Math.round(w * k); c.height = Math.round(h * k);
          c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
          var dataUrl = c.toDataURL('image/jpeg', 0.82);
          resolve({ name: file.name, type: 'image/jpeg', data: dataUrl.split(',')[1] });
        } catch (e) { resolve(null); } finally { URL.revokeObjectURL(url); }
      };
      img.onerror = function () { URL.revokeObjectURL(url); resolve(null); };
      img.src = url;
    });
  };
  var api = form.getAttribute('data-api');
  form.addEventListener('submit', function (e) {
    if (!form.checkValidity()) return;
    sending(true);
    if (!api || !window.fetch || form.dataset.fallback === '1') return; // native POST to FormSubmit
    e.preventDefault();
    var fd = new FormData(form), body = {
      name: fd.get('Name'), phone: fd.get('Phone'), email: fd.get('Email'), contact: fd.get('Preferred contact'),
      street: fd.get('Street address'), city: fd.get('City'), state: fd.get('State'), zip: fd.get('ZIP'),
      service: fd.get('Service'), count: fd.get('Number of stumps'), diameter: fd.get('Largest stump diameter'),
      access: fd.get('Access'), after: fd.get('After the stump is gone'), nearby: fd.getAll('Nearby'),
      notes: fd.get('Notes'), heard: fd.get('How did you hear about us'), website: fd.get('_honey') || ''
    };
    var files = [].slice.call((form.querySelector('input[type=file]') || { files: [] }).files).slice(0, 6);
    Promise.all(files.map(shrink)).then(function (photos) {
      body.photos = photos.filter(Boolean);
      var ctrl = typeof AbortController === 'function' ? new AbortController() : null;
      var timer = ctrl && setTimeout(function () { ctrl.abort(); }, 25000);
      return fetch(api, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body), signal: ctrl ? ctrl.signal : undefined })
        .then(function (r) { return r.json().then(function (j) { return { ok: r.ok && j && j.ok }; }); })
        .finally(function () { if (timer) clearTimeout(timer); });
    }).then(function (r) {
      if (r.ok) { location.href = next ? next.value : 'service-request.html?sent=1'; return; }
      throw new Error('api');
    }).catch(function () {
      // Homeworks unreachable (or JS hiccup): send the same submission by email instead
      form.dataset.fallback = '1'; sending(false); form.requestSubmit ? form.requestSubmit() : form.submit();
    });
  });
})();
</script>
