---
// The service-request intake form as a modal window, available on every v2 page (included by Site.astro).
// Any element with [data-open-form] opens it; its href (service-request.html#request) is the no-JS /
// legacy-page fallback — that page opens the dialog on arrival when the hash is #request.
// Fields, copy and delivery config live in data/service-request.ts (see CLAUDE.md "Intake form").
import Icon from './Icon.astro';
import { form, options } from '../../data/service-request';
const configured = Boolean(form.action);
---
<dialog class="dialog" id="request" aria-labelledby="dialog-title">
  <div class="dialog-head">
    <div>
      <p class="eyebrow">Free estimate</p>
      <h2 id="dialog-title">Tell us about your stump</h2>
      <p class="dialog-sub">Takes about a minute. We'll follow up with a written scope and price.</p>
    </div>
    <button class="btn btn-ghost btn-icon dialog-close" type="button" data-close-form aria-label="Close the form"><Icon name="x" size={20} /></button>
  </div>
  <div class="dialog-body">
    {!configured && (
      <p class="notice" role="status">
        <Icon name="triangle-alert" size={18} /><span><strong>Delivery not set up yet.</strong> The form is built, but where submissions go hasn't been chosen — the button stays off until it is.</span>
      </p>
    )}

    <form id="intake" action={form.action || undefined} method={form.method} enctype="multipart/form-data" data-api={form.api} data-api-origin={form.apiOrigin} data-maps-key={form.mapsKey || undefined}>
      {Object.entries(form.hidden).map(([k, v]) => <input type="hidden" name={k} value={v} />)}
      <input type="hidden" name="_next" id="next" value={form.nextDefault} />
      <p class="honey" aria-hidden="true"><label>Leave this field empty <input type="text" name={form.honeypot} tabindex="-1" autocomplete="off" /></label></p>

      <div class="form-section">
        <div class="form-grid">
          <div class="field span-2">
            <label for="name">Name<span class="req" aria-hidden="true">*</span></label>
            <input class="input" id="name" name="Name" type="text" autocomplete="name" required />
            <span class="error">Please enter your name.</span>
          </div>
          <div class="field">
            <label for="phone">Phone</label>
            <input class="input" id="phone" name="Phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="509-555-0123" />
            <span class="error">Give us a phone number or an email so we can get back to you.</span>
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input class="input" id="email" name="Email" type="email" autocomplete="email" inputmode="email" placeholder="you@example.com" />
            <span class="error">That doesn't look like a valid email.</span>
          </div>
          <p class="hint span-2 contact-hint">Phone or email — whichever you'd rather we use.</p>
        </div>
      </div>

      <div class="form-section">
        <div class="field ac-wrap">
          <label for="address">Where's the stump?<span class="req" aria-hidden="true">*</span></label>
          <input class="input" id="address" name="Address" type="text" autocomplete="off" placeholder="Start typing the address…" required aria-autocomplete="list" aria-controls="ac-list" aria-expanded="false" />
          <ul class="ac-list" id="ac-list" role="listbox" hidden></ul>
          <span class="error">We need the address to price access and travel.</span>
          <span class="hint ac-hint">Pick the address from the list, or type it in full — street, city, state.</span>
          <input type="hidden" name="Street address" id="street" />
          <input type="hidden" name="City" id="city" />
          <input type="hidden" name="State" id="state" />
          <input type="hidden" name="ZIP" id="zip" />
        </div>
      </div>

      <div class="form-section">
        <fieldset class="field">
          <legend>What do you need?</legend>
          <div class="choices">
            {options.service.map((s, i) => (<label class="choice"><input type="radio" name="Service" value={s.value} required checked={i === 0} /><span><strong>{s.label}</strong>{s.help}</span></label>))}
          </div>
        </fieldset>
        <div class="field">
          <label for="photos">Photos of the stump <span class="hint">(optional, but they save a trip)</span></label>
          <input class="input" id="photos" name="Photos" type="file" accept="image/*" multiple />
        </div>
        <div class="field">
          <label for="notes">Anything we should know? <span class="hint">(optional)</span></label>
          <textarea class="textarea" id="notes" name="Notes" rows="4" placeholder={options.notesPlaceholder}></textarea>
        </div>
      </div>

      <div class="form-foot">
        <div class="btn-row">
          <button class="btn btn-primary btn-lg btn-submit" type="submit" disabled={!configured}><Icon name="send" size={18} /> <span class="label">Send my request</span></button>
          <button class="btn btn-outline btn-lg" type="button" data-close-form>Cancel</button>
        </div>
        <p class="fine">We'll only use this to put together your estimate and get back to you. No spam, no sharing.</p>
      </div>
    </form>
  </div>
</dialog>

<script is:inline>
(function () {
  var dlg = document.getElementById('request'), form = document.getElementById('intake');
  if (!dlg || !form) return;
  var $ = function (id) { return document.getElementById(id); };
  // after FormSubmit's redirect (fallback path) the customer lands on thank-you.html — send them there from any page
  var next = $('next');
  if (next) next.value = location.origin + location.pathname.replace(/[^/]*$/, '') + 'thank-you.html';
  var open = function (e) {
    if (e) e.preventDefault();
    if (typeof dlg.showModal === 'function') { if (!dlg.open) dlg.showModal(); dlg.querySelector('.dialog-body').scrollTop = 0; }
    else dlg.setAttribute('open', '');
    loadMaps();
  };
  var close = function () { dlg.close ? dlg.close() : dlg.removeAttribute('open'); };
  document.querySelectorAll('[data-open-form]').forEach(function (b) { b.addEventListener('click', open); });
  document.querySelectorAll('[data-close-form]').forEach(function (b) { b.addEventListener('click', close); });
  dlg.addEventListener('click', function (e) { if (e.target === dlg) close(); }); // click on the backdrop
  var fromHash = function () { if (location.hash === '#request') { open(); try { history.replaceState(null, '', location.pathname + location.search); } catch (err) {} } };
  fromHash(); window.addEventListener('hashchange', fromHash);

  // ---- phone OR email: one of them is required, enforced quietly ----
  var phone = $('phone'), email = $('email');
  var checkContact = function () {
    var ok = phone.value.replace(/\D/g, '').length >= 7 || (email.value.trim() && email.checkValidity());
    phone.setCustomValidity(ok ? '' : 'Give us a phone number or an email so we can get back to you.');
    email.setCustomValidity('');
  };
  phone.addEventListener('input', checkContact); email.addEventListener('input', checkContact);
  checkContact(); // so the browser's own validation knows from the start that one of them is needed

  // ---- one address box: Google Places suggestions fill street/city/state/zip quietly ----
  var addr = $('address'), list = $('ac-list'), parts = { street: $('street'), city: $('city'), state: $('state'), zip: $('zip') };
  var mapsKey = form.getAttribute('data-maps-key'), mapsLoading = false, session = null, active = -1, items = [];
  var placesReady = function () { return !!(window.google && google.maps && google.maps.places && google.maps.places.AutocompleteSuggestion); };
  function loadMaps() {
    if (placesReady() || mapsLoading || !mapsKey) return;
    mapsLoading = true;
    // Google's official bootstrap (loads only the Places library, only once the form is opened)
    (function (g) { var h, a, k, p = 'The Google Maps JavaScript API', c = 'google', l = 'importLibrary', q = '__ib__', m = document, b = window; b = b[c] || (b[c] = {}); var d = b.maps || (b.maps = {}), r = new Set(), e = new URLSearchParams(), u = function () { return h || (h = new Promise(function (f, n) { a = m.createElement('script'); e.set('libraries', [].concat(r).join(',')); for (k in g) e.set(k.replace(/[A-Z]/g, function (t) { return '_' + t[0].toLowerCase(); }), g[k]); e.set('callback', c + '.maps.' + q); a.src = 'https://maps.' + c + 'apis.com/maps/api/js?' + e; d[q] = f; a.onerror = function () { h = n(Error(p + ' could not load.')); }; a.nonce = m.querySelector('script[nonce]') ? m.querySelector('script[nonce]').nonce : ''; m.head.append(a); })); }; d[l] ? console.warn(p + ' only loads once. Ignoring:', g) : d[l] = function (f) { for (var n = arguments.length, t = new Array(n > 1 ? n - 1 : 0), i = 1; i < n; i++) t[i - 1] = arguments[i]; return r.add(f) && u().then(function () { return d[l].apply(d, [f].concat(t)); }); }; })({ key: mapsKey, v: 'weekly' });
    google.maps.importLibrary('places').catch(function () { mapsLoading = false; });
  }
  var clearParts = function () { for (var k in parts) parts[k].value = ''; };
  var hide = function () { list.hidden = true; list.innerHTML = ''; items = []; active = -1; addr.setAttribute('aria-expanded', 'false'); };
  var render = function () {
    list.innerHTML = '';
    items.forEach(function (it, i) {
      var li = document.createElement('li'); li.setAttribute('role', 'option'); li.id = 'ac-' + i; li.className = i === active ? 'active' : '';
      var main = document.createElement('strong'); main.textContent = it.main; var sub = document.createElement('span'); sub.textContent = it.secondary;
      li.appendChild(main); li.appendChild(sub);
      li.addEventListener('mousedown', function (e) { e.preventDefault(); choose(i); });
      list.appendChild(li);
    });
    list.hidden = items.length === 0; addr.setAttribute('aria-expanded', list.hidden ? 'false' : 'true');
  };
  var timer = null;
  var suggest = function () {
    var q = addr.value.trim(); clearParts();
    if (!placesReady() || q.length < 3) { hide(); return; }
    session = session || new google.maps.places.AutocompleteSessionToken();
    google.maps.places.AutocompleteSuggestion.fetchAutocompleteSuggestions({
      input: q, sessionToken: session, includedRegionCodes: ['us'], includedPrimaryTypes: ['street_address', 'premise', 'subpremise', 'route'],
      locationBias: { west: -118.1, south: 47.2, east: -116.5, north: 48.4 }, // Spokane through Coeur d'Alene / Sandpoint (a circle is capped at 50 km)
    }).then(function (r) {
      items = (r.suggestions || []).map(function (s) {
        var p = s.placePrediction; return { main: p.mainText ? p.mainText.text : p.text.text, secondary: p.secondaryText ? p.secondaryText.text : '', pred: p };
      }).slice(0, 5);
      active = -1; render();
    }).catch(hide);
  };
  var choose = function (i) {
    var it = items[i]; if (!it) return;
    hide(); addr.value = it.main + (it.secondary ? ', ' + it.secondary : '');
    var place = it.pred.toPlace();
    place.fetchFields({ fields: ['addressComponents', 'formattedAddress'] }).then(function () {
      var c = {}; (place.addressComponents || []).forEach(function (x) { (x.types || []).forEach(function (t) { c[t] = x.shortText || x.longText; }); });
      parts.street.value = [c.street_number, c.route].filter(Boolean).join(' ');
      parts.city.value = c.locality || c.sublocality || c.postal_town || c.administrative_area_level_3 || '';
      parts.state.value = c.administrative_area_level_1 || '';
      parts.zip.value = c.postal_code || '';
      if (place.formattedAddress) addr.value = place.formattedAddress.replace(/, USA$/, '');
      session = null; // a pick ends the billing session
    }).catch(function () {});
  };
  addr.addEventListener('input', function () { clearTimeout(timer); timer = setTimeout(suggest, 180); });
  addr.addEventListener('focus', function () { loadMaps(); });
  addr.addEventListener('blur', function () { setTimeout(hide, 120); });
  addr.addEventListener('keydown', function (e) {
    if (list.hidden) return;
    if (e.key === 'ArrowDown') { e.preventDefault(); active = (active + 1) % items.length; render(); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); active = (active - 1 + items.length) % items.length; render(); }
    else if (e.key === 'Enter') { if (active >= 0) { e.preventDefault(); choose(active); } }
    else if (e.key === 'Escape') { hide(); }
  });

  var sending = function (on) {
    form.classList.toggle('sending', on);
    var b = form.querySelector('.btn-submit'); if (b) { b.setAttribute('aria-busy', on ? 'true' : 'false'); b.querySelector('.label').textContent = on ? 'Sending…' : 'Send my request'; }
  };
  // Shrink a photo in the browser (max 1600px, JPEG) so the whole request stays small. Always resolves with a
  // record for the file — data: null + reason when it can't be used — so the server can log what happened.
  var RAW_OK = /^image\/(jpeg|png|webp)$/, RAW_MAX = 2500000;
  var readRaw = function (file, meta, reason) {
    return new Promise(function (resolve) {
      if (!RAW_OK.test(file.type) || file.size > RAW_MAX) return resolve(Object.assign(meta, { data: null, reason: reason + '; raw not sendable (' + (file.type || 'no type') + ', ' + file.size + ' B)' }));
      var fr = new FileReader();
      fr.onload = function () { resolve(Object.assign(meta, { type: file.type, data: String(fr.result).split(',')[1], reason: reason + '; sent raw' })); };
      fr.onerror = function () { resolve(Object.assign(meta, { data: null, reason: reason + '; raw read failed' })); };
      fr.readAsDataURL(file);
    });
  };
  var shrink = function (file) {
    var meta = { name: file.name, srcType: file.type || '', srcSize: file.size };
    return new Promise(function (resolve) {
      if (!/^image\//.test(file.type)) return resolve(Object.assign(meta, { data: null, reason: 'not an image type' }));
      var img = new Image(), url = URL.createObjectURL(file), done = false;
      var finish = function (v) { if (done) return; done = true; URL.revokeObjectURL(url); resolve(v); };
      img.onload = function () {
        try {
          var max = 1600, w = img.naturalWidth, h = img.naturalHeight, k = Math.min(1, max / Math.max(w, h));
          var c = document.createElement('canvas'); c.width = Math.round(w * k); c.height = Math.round(h * k);
          c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
          var dataUrl = c.toDataURL('image/jpeg', 0.82);
          finish(Object.assign(meta, { type: 'image/jpeg', data: dataUrl.split(',')[1], reason: 'shrunk ' + w + 'x' + h + ' -> ' + c.width + 'x' + c.height }));
        } catch (e) { readRaw(file, meta, 'canvas failed: ' + (e && e.message)).then(finish); }
      };
      img.onerror = function () { readRaw(file, meta, 'browser cannot decode ' + (file.type || 'unknown type')).then(finish); };
      setTimeout(function () { if (!done) readRaw(file, meta, 'decode timed out').then(finish); }, 15000);
      img.src = url;
    });
  };
  var api = form.getAttribute('data-api'), apiOrigin = form.getAttribute('data-api-origin') || '';
  // on the live site but not on the canonical host (e.g. the bare domain) → call the function on the canonical host
  if (api && apiOrigin && /spokanestumpgrinder\.com$/.test(location.hostname) && location.origin !== apiOrigin) api = apiOrigin + api;
  form.addEventListener('submit', function (e) {
    checkContact();
    if (!form.checkValidity()) { e.preventDefault(); form.reportValidity(); return; }
    sending(true);
    if (!api || !window.fetch || form.dataset.fallback === '1') return; // native POST to FormSubmit
    e.preventDefault();
    var fd = new FormData(form), body = {
      name: fd.get('Name'), phone: fd.get('Phone'), email: fd.get('Email'),
      address: fd.get('Address'), street: fd.get('Street address'), city: fd.get('City'), state: fd.get('State'), zip: fd.get('ZIP'),
      service: fd.get('Service'), notes: fd.get('Notes'), website: fd.get('_honey') || ''
    };
    var files = [].slice.call((form.querySelector('input[type=file]') || { files: [] }).files).slice(0, 6);
    Promise.all(files.map(shrink)).then(function (photos) {
      body.photos = photos; // every selected file, with data or a reason
      var ctrl = typeof AbortController === 'function' ? new AbortController() : null;
      var t = ctrl && setTimeout(function () { ctrl.abort(); }, 25000);
      return fetch(api, { method: 'POST', headers: { 'content-type': 'text/plain;charset=UTF-8' }, body: JSON.stringify(body), signal: ctrl ? ctrl.signal : undefined }) // text/plain = no CORS preflight; the function parses JSON either way
        .then(function (r) { return r.json().then(function (j) { return { ok: r.ok && j && j.ok }; }); })
        .finally(function () { if (t) clearTimeout(t); });
    }).then(function (r) {
      if (r.ok) { location.href = next ? next.value : 'thank-you.html'; return; }
      throw new Error('api');
    }).catch(function () {
      // Homeworks unreachable (or JS hiccup): send the same submission by email instead
      form.dataset.fallback = '1'; sending(false); form.requestSubmit ? form.requestSubmit() : form.submit();
    });
  });
})();
</script>
