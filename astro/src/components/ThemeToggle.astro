<button type="button" class="theme-toggle" id="theme-toggle" data-mode="system" aria-pressed="false" aria-label="Theme: System. Click for Light">
  <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
  <svg class="icon-system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor"/></svg>
  <span class="theme-label">System</span>
</button>
<script is:inline>
(function(){
  var root=document.documentElement, btn=document.getElementById('theme-toggle'),
      mq=window.matchMedia?window.matchMedia('(prefers-color-scheme: dark)'):null;
  function stored(){try{return localStorage.getItem('ssg-theme');}catch(e){return null;}}
  function mode(){var t=stored();return (t==='light'||t==='dark')?t:'system';}
  function apply(m){
    if(m==='light'||m==='dark'){root.setAttribute('data-theme',m);try{localStorage.setItem('ssg-theme',m);}catch(e){}}
    else{root.removeAttribute('data-theme');try{localStorage.setItem('ssg-theme','system');}catch(e){}}
    sync();
  }
  function sync(){
    var m=mode(), next=m==='system'?'light':(m==='light'?'dark':'system');
    var labels={system:'System',light:'Light',dark:'Dark'};
    btn.setAttribute('data-mode',m);
    btn.classList.toggle('is-dark',m==='dark'||(m==='system'&&mq&&mq.matches));
    btn.setAttribute('aria-pressed',m==='system'?'false':'true');
    btn.setAttribute('aria-label','Theme: '+labels[m]+'. Click for '+labels[next]);
    btn.querySelector('.theme-label').textContent=labels[m];
  }
  btn.addEventListener('click',function(){
    var m=mode();
    apply(m==='system'?'light':(m==='light'?'dark':'system'));
  });
  if(mq&&mq.addEventListener){mq.addEventListener('change',function(){if(mode()==='system')sync();});}
  document.querySelectorAll('.grid > .card, .steps > .step, .grid > .factor, .pillars > .pillar, .grid > .chip-card, .stats > .stat, .models > .model').forEach(function(el){
    var w=document.createElement('div');
    w.className='pop-cell';
    el.parentNode.classList.add('pop-grid');
    el.parentNode.insertBefore(w,el);
    w.appendChild(el);
  });
  sync();
})();
</script>
