---
import Site from '../layouts/Site.astro';
import '../styles/pages/about-v2.css';
import Icon from '../components/v2/Icon.astro';
import Img from '../components/v2/Img.astro';
import { hero, facts, story, pillars, how, team, credentials, closing } from '../data/about';
import { towns } from '../data/home';
import { business } from '../data/site';

const SITE = 'https://spokanestumpgrinder.com/';
const aboutLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': SITE + 'about.html',
  url: SITE + 'about.html',
  name: 'About Spokane Stump Grinder',
  mainEntity: {
    '@type': 'LocalBusiness',
    '@id': SITE + '#business',
    name: business.name,
    url: SITE,
    telephone: '+1-509-434-9554',
    email: business.email,
    address: { '@type': 'PostalAddress', streetAddress: business.street, addressLocality: 'Spokane', addressRegion: 'WA', postalCode: '99202', addressCountry: 'US' },
    areaServed: towns.map((t) => ({ '@type': 'City', name: t.name })),
    founder: { '@type': 'Person', name: 'Jeff James', jobTitle: 'Owner', image: SITE + 'images/jeff-james-headshot.png' },
  },
};

const meta = {
  title: 'About Us | Spokane Stump Grinder',
  description: "Spokane natives serving the Spokane and Coeur d'Alene region since 2023. Straightforward stump grinding and removal, written estimates, and no hidden fees.",
  canonical: SITE + 'about.html',
  og: { type: 'website', title: 'About Us | Spokane Stump Grinder', description: "Spokane natives serving the Spokane and Coeur d'Alene region since 2023. Straightforward stump grinding and removal, written estimates, and no hidden fees.", url: SITE + 'about.html', image: SITE + 'images/about-stump-profile.jpg', site_name: business.name },
  twitterCard: 'summary_large_image',
  jsonld: [JSON.stringify(aboutLd, null, 2)],
  active: 'about.html',
};
---
<Site {...meta}>

  <!-- HERO -->
  <section class="about-hero">
    <div class="container about-hero-grid">
      <div>
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1>{hero.h1}</h1>
        <p class="lede">{hero.lede}</p>
        <div class="btn-row">
          <a class="btn btn-primary btn-lg" href={hero.primary.href}>{hero.primary.label} <Icon name="arrow-right" size={18} /></a>
          <a class="btn btn-outline btn-lg" href={hero.secondary.href}>{hero.secondary.label}</a>
        </div>
      </div>
      <div class="portrait">
        <Img file={hero.portrait.file} alt={hero.portrait.alt} widths={[480, 800, 1045]} sizes="(max-width: 64rem) 100vw, 420px" loading="eager" fetchpriority="high" />
        <div class="portrait-chip"><span class="icon-chip"><Icon name="user" size={18} /></span><span><strong>Jeff James</strong> Owner</span></div>
      </div>
    </div>
  </section>

  <!-- QUICK FACTS -->
  <div class="container">
    <ul class="facts" aria-label="Quick facts">
      {facts.map((f) => (
        <li><span class="icon-chip"><Icon name={f.icon} size={20} /></span><div><strong>{f.value}</strong><span>{f.label}</span></div></li>
      ))}
    </ul>
  </div>

  <!-- STORY -->
  <section class="section section-muted" id="story">
    <div class="container">
      <div class="story-grid">
        <div class="story-text">
          <p class="eyebrow">{story.eyebrow}</p>
          <h2>{story.h2}</h2>
          <p class="lede">{story.lead}</p>
          {story.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <div class="story-side">
          <figure class="story-photo">
            <Img file={story.photo.file} alt={story.photo.alt} widths={[480, 800, 1200]} sizes="(max-width: 64rem) 100vw, 440px" />
          </figure>
          <blockquote class="card quote">
            <Icon name="quote" size={28} />
            <p>{story.quote.text}</p>
            <cite>&mdash; {story.quote.cite}</cite>
          </blockquote>
        </div>
      </div>
    </div>
  </section>

  <!-- PILLARS -->
  <section class="section" id="values">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{pillars.eyebrow}</p>
        <h2>{pillars.h2}</h2>
      </div>
      <div class="pillars">
        {pillars.items.map((p) => (
          <article class="card pillar">
            <span class="icon-chip"><Icon name={p.icon} size={22} /></span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW WE WORK -->
  <section class="section section-ink" id="how-we-work">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{how.eyebrow}</p>
        <h2>{how.h2}</h2>
        <p class="lede">{how.lede}</p>
      </div>
      <div class="how-grid">
        {how.items.map((h) => (
          <article class="how">
            <span class="icon-chip on-ink"><Icon name={h.icon} size={20} /></span>
            <h3>{h.title}</h3>
            <p>{h.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- TEAM -->
  <section class="section" id="team">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{team.eyebrow}</p>
        <h2>{team.h2}</h2>
      </div>
      {team.members.map((m) => (
        <article class="card bio">
          <div class="bio-photo"><Img file={m.photo.file} alt={m.photo.alt} widths={[480, 800, 1045]} sizes="(max-width: 48rem) 100vw, 300px" /></div>
          <div class="bio-text">
            <h3>{m.name}</h3>
            <p class="role"><span class="badge badge-red">{m.role}</span></p>
            {m.paragraphs.map((p) => <p>{p}</p>)}
            <div class="btn-row bio-cta">
              <a class="btn btn-outline" href={`tel:${business.phoneHref}`}><Icon name="phone" size={18} /> Call or text {business.phoneDisplay}</a>
              <a class="btn btn-outline" href="contact.html"><Icon name="message-circle" size={18} /> Contact</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- CREDENTIALS -->
  <section class="section section-muted" id="credentials">
    <div class="container cred-grid">
      <div class="section-head">
        <p class="eyebrow">{credentials.eyebrow}</p>
        <h2>{credentials.h2}</h2>
        <p class="lede">{credentials.lede}</p>
        <ul class="checks cred-checks">
          <li><Icon name="shield-check" size={18} />Licensed</li>
          <li><Icon name="shield-check" size={18} />Bonded</li>
          <li><Icon name="shield-check" size={18} />Insured</li>
        </ul>
      </div>
      <div class="card cred-card">
        <dl class="cred">
          {credentials.rows.map((r) => (
            <div class="cred-row">
              <span class="icon-chip"><Icon name={r.icon} size={18} /></span>
              <dt>{r.label}</dt>
              <dd>{r.value}</dd>
            </div>
          ))}
        </dl>
        <p class="cred-note"><Icon name="file-check" size={16} /> {credentials.note}</p>
      </div>
    </div>
  </section>

  <!-- SERVICE AREA -->
  <section class="section" id="service-area">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Where we work</p>
        <h2>Serving the Spokane &amp; Coeur d'Alene region</h2>
        <p class="lede">Based in Spokane and covering communities across Eastern Washington and North Idaho.</p>
      </div>
      <div class="towns">
        {towns.map((t) => t.href ? (<a class="badge has-page" href={t.href}><Icon name="map-pin" size={14} />{t.name}</a>) : (<span class="badge">{t.name}</span>))}
      </div>
      <p class="area-note">Don't see your town? Give us a call &mdash; if you're near the edge of the map we'll let you know straight.</p>
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section class="section" style="padding-top: 0">
    <div class="container">
      <div class="card closing">
        <h2>{closing.h2}</h2>
        <p class="lede">{closing.text}</p>
        <div class="btn-row">
          <a class="btn btn-primary btn-lg" href="service-request.html">Request service</a>
          <a class="btn btn-outline btn-lg" href={`tel:${business.phoneHref}`}><Icon name="phone" size={18} /> Call or text {business.phoneDisplay}</a>
          <a class="btn btn-outline btn-lg" href="case-studies.html">See our work</a>
        </div>
      </div>
    </div>
  </section>

</Site>
