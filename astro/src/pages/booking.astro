---
import Site from '../layouts/Site.astro';
import '../styles/pages/booking-v2.css';
import Icon from '../components/v2/Icon.astro';
import { calendar, hero, steps, prep, closing } from '../data/booking';
import { business } from '../data/site';

const SITE = 'https://spokanestumpgrinder.com/';
const pageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': SITE + 'booking.html',
  url: SITE + 'booking.html',
  name: 'Book an On-Site Consultation (OSC)',
  potentialAction: { '@type': 'ReserveAction', target: calendar.directLink, name: 'Book a free on-site consultation' },
  about: { '@type': 'LocalBusiness', '@id': SITE + '#business', name: business.name, telephone: '+1-509-434-9554' },
};

const meta = {
  title: 'Book an On-Site Consultation (OSC) | Spokane Stump Grinder',
  description: 'Book a free on-site consultation (OSC) for stump grinding in Spokane, WA. Pick a time from our live calendar and see how to prep for the visit.',
  canonical: SITE + 'booking.html',
  og: { type: 'website', title: 'Book an On-Site Consultation (OSC) | Spokane Stump Grinder', description: 'Book a free on-site consultation (OSC) for stump grinding in Spokane, WA. Pick a time from our live calendar and see how to prep for the visit.', url: SITE + 'booking.html', image: SITE + 'images/about-stump-profile.jpg', site_name: business.name },
  twitterCard: 'summary_large_image',
  jsonld: [JSON.stringify(pageLd, null, 2)],
  active: 'booking.html',
};
---
<Site {...meta}>

  <!-- HERO -->
  <section class="book-hero">
    <div class="container">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1>Book an <span style="white-space: nowrap">On-Site</span> Consultation</h1>
      <p class="lede">{hero.lede}</p>
      <div class="btn-row">
        <a class="btn btn-primary btn-lg" href="#book"><Icon name="calendar-check" size={18} /> Pick a time below</a>
        <a class="btn btn-outline btn-lg" href={hero.secondary.href}>{hero.secondary.label}</a>
      </div>
      <ul class="hero-proof" aria-label="What to expect">
        <li class="badge"><Icon name="badge-check" size={14} /> Free, no obligation</li>
        <li class="badge"><Icon name="clock" size={14} /> Written estimate after the visit</li>
        <li class="badge"><Icon name="phone" size={14} /> You don't have to be home</li>
      </ul>
    </div>
  </section>

  <!-- SEQUENCE -->
  <section class="section section-muted">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">The order of things</p>
        <h2>Your OSC first, then a plan</h2>
      </div>
      <ol class="steps">
        {steps.map((s) => (<li class="card step"><h3>{s.title}</h3><p>{s.text}</p></li>))}
      </ol>
    </div>
  </section>

  <!-- BOOK -->
  <section class="section" id="book">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Check availability</p>
        <h2>Pick a time that works</h2>
        <p class="lede">Our live calendar shows what's open for a free OSC. Grab the slot you want and it's yours.</p>
      </div>
      <div class="book-grid">
        <div class="card cal-card">
          <!-- Google Calendar Appointment Scheduling begin -->
          <iframe src={calendar.embedSrc} style="border: 0" width="100%" height="600" frameborder="0" title="Book an on-site consultation — Google Calendar appointment schedule"></iframe>
          <!-- end Google Calendar Appointment Scheduling -->
        </div>
        <aside class="card fallback">
          <h3>Calendar not loading?</h3>
          <p>Open the booking page directly, or just call us.</p>
          <a class="btn btn-primary" href={calendar.directLink} target="_blank" rel="noopener">Open booking calendar <Icon name="external-link" size={16} /></a>
          <div class="or">or call / text</div>
          <a class="callline" href={`tel:${business.phoneHref}`}><Icon name="phone" size={22} /> {business.phoneDisplay}</a>
          <ul class="checks">
            <li><Icon name="check" size={18} />Reschedule from the link in your Google Calendar confirmation</li>
            <li><Icon name="check" size={18} /><span>Prefer photos first? <a href="service-request.html">Send the details</a> instead</span></li>
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <!-- PREP -->
  <section class="section section-muted" id="prep">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{prep.eyebrow}</p>
        <h2>{prep.h2}</h2>
        <p class="lede">{prep.lede}</p>
      </div>
      <div class="prep-grid">
        {prep.items.map((p) => (
          <article class="card prep">
            <span class="icon-chip"><Icon name={p.icon} size={20} /></span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section class="section">
    <div class="container">
      <div class="card closing">
        <h2>{closing.h2}</h2>
        <p class="lede">{closing.text}</p>
        <div class="btn-row">
          <a class="btn btn-primary btn-lg" href={calendar.directLink} target="_blank" rel="noopener"><Icon name="calendar-check" size={18} /> Book an OSC</a>
          <a class="btn btn-outline btn-lg" href={`tel:${business.phoneHref}`}><Icon name="phone" size={18} /> Call or text {business.phoneDisplay}</a>
          <a class="btn btn-outline btn-lg" href="service-request.html">Request an estimate</a>
        </div>
        <p class="faq-link">Got more questions first? Check the <a href="faq.html#scheduling">FAQ page</a>.</p>
      </div>
    </div>
  </section>

</Site>
