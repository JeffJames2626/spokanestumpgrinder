const others = posts.filter((x) => x.file !== 'blog-private-locates.html').slice(0, 4);
import Site from '../layouts/Site.astro';

const meta = {
  title: "Private Utility Locates: What They Cost | Spokane Stump Grinder Blog",
  description: "811 only covers utility-owned lines. Here's what a private locate covers, when you actually need one, and what it typically costs.",
  canonical: "https://spokanestumpgrinder.com/blog-private-locates.html",
  og: { type: "article", title: "Private utility locates: what they cost and when you need one", description: "811 only covers utility-owned lines. Here's what a private locate covers, when you actually need one, and what it typically costs.", url: "https://spokanestumpgrinder.com/blog-private-locates.html", image: "https://spokanestumpgrinder.com/images/about-stump-profile.jpg", site_name: "Spokane Stump Grinder" },
  twitterCard: "summary_large_image",
  jsonld: [JSON.stringify({"@context": "https://schema.org", "@type": "BlogPosting", "@id": "https://spokanestumpgrinder.com/blog-private-locates.html", "mainEntityOfPage": "https://spokanestumpgrinder.com/blog-private-locates.html", "headline": "Private utility locates: what they cost and when you need one", "description": "811 only covers utility-owned lines. Here's what a private locate covers, when you actually need one, and what it typically costs.", "datePublished": "2026-08-16", "dateModified": "2026-08-16", "author": {"@type": "Organization", "name": "Spokane Stump Grinder"}, "publisher": {"@type": "Organization", "@id": "https://spokanestumpgrinder.com/#business", "name": "Spokane Stump Grinder"}})],
  active: "blog.html",
};
---
<Site {...meta}>
<section class="post-hero">
  <div class="container">
    <p class="eyebrow">Blog</p>
    <h1>Private utility locates: what they cost and when you need one</h1>
    <p>811 covers utility-owned lines up to your meter, and stops there. Here's what a private locate covers instead, when it's actually worth calling one, and what drives the cost.</p>
    <p class="post-meta">August 2026</p>
  </div>
</section>

<section class="section">
  <div class="container case-layout">
  <article class="article">

    <h2 id="where-811-stops">Where 811 stops</h2>
    <p>We covered the basics of <a href="blog-811-locates.html">calling 811 before you dig</a> in an earlier post — it's free, and it covers the utility-owned lines running to your property: gas, electric, water, sewer, cable, internet. What it doesn't cover is anything on the private side of the meter: your own sprinkler system, low-voltage landscape lighting, invisible pet fence, or septic lines. That's where a private locate comes in.</p>

    <h2 id="what-a-private-locate-actually-is">What a private locate actually is</h2>
    <p>A private locate is a paid, independently arranged service — not part of the free 811 ticket. A locator comes out and traces the lines you actually own, using the same kind of electromagnetic locating equipment utility locators use for metal or tracer-wire lines, and sometimes ground-penetrating radar (GPR) for non-metallic pipe — like plain PVC irrigation line or older septic pipe — that a standard locator can't pick up.</p>

    <h2 id="when-you-d-actually-need-one">When you'd actually need one</h2>
    <div class="grid">
      <div class="chip-card">
        <strong>Full removal jobs</strong>
        <span>Digging out a root ball goes wider and deeper than grinding alone</span>
      </div>
      <div class="chip-card">
        <strong>Unknown irrigation</strong>
        <span>Older property, no as-built plans, or zones added without records</span>
      </div>
      <div class="chip-card">
        <strong>Invisible pet fence</strong>
        <span>Boundary wire with an unclear or forgotten layout</span>
      </div>
      <div class="chip-card">
        <strong>Septic systems</strong>
        <span>No accurate map of tank or line locations on file</span>
      </div>
    </div>

    <div class="callout">
      <p><strong>Worth knowing:</strong> an 811 ticket coming back "clear" only means there's nothing utility-owned in the way. It says nothing about what's on your side of the meter.</p>
    </div>

    <h2 id="who-provides-them">Who provides them</h2>
    <p>Independent utility-locating companies handle most private locates. Some irrigation or landscape contractors can trace their own systems directly. For non-metallic lines that standard equipment can't detect, look specifically for a provider that offers GPR — not every locator does.</p>

    <h2 id="what-drives-the-cost">What drives the cost</h2>
    <p>Pricing varies by provider and job, but the factors that move it are consistent:</p>
    <ul>
      <li>How much ground has to be searched</li>
      <li>How many separate systems need tracing — irrigation, lighting, fence, and septic are usually priced as separate lines of work</li>
      <li>Line material — metal or tracer-wire lines are faster and cheaper to trace than plain non-metallic pipe that needs GPR</li>
      <li>Site access and how built-up or obstructed the yard is</li>
      <li>Turnaround time — a rush request typically costs more than standard scheduling</li>
    </ul>
    <div class="callout">
      <p><strong>What it typically runs:</strong> most private locators in our area charge <strong>$185&ndash;$200 an hour</strong>, depending on who you call. A single system on a small, open lot lands toward the low end; multiple systems, GPR work, or a rushed timeline push it toward the top.</p>
    </div>

    <h2 id="who-arranges-it-for-your-job">Who arranges it for your job</h2>
    <p>We don't build a private locate into every quote — most jobs never need one. But when we walk a site and think there's a real chance something private is buried where we'll be working, we'll say so and point you toward a locator we trust. Call it an occasional recommendation, not standard practice: not rare, but not common either.</p>

    <h2 id="bottom-line">Bottom line</h2>
    <p>If your yard has irrigation, landscape lighting, an invisible fence, or a septic system and you don't have solid documentation of where the lines run, a private locate before a big removal job is cheap insurance against hitting something expensive to fix.</p>

    <a class="back-link" href="blog.html">&larr; Back to all posts</a>
  </article>

    <aside class="case-side">
      <div class="toc">
        <h2>On this page</h2>
        <ol>
          <li><a href="#where-811-stops">Where 811 stops</a></li>
          <li><a href="#what-a-private-locate-actually-is">What a private locate actually is</a></li>
          <li><a href="#when-you-d-actually-need-one">When you'd actually need one</a></li>
          <li><a href="#who-provides-them">Who provides them</a></li>
          <li><a href="#what-drives-the-cost">What drives the cost</a></li>
          <li><a href="#who-arranges-it-for-your-job">Who arranges it for your job</a></li>
          <li><a href="#bottom-line">Bottom line</a></li>
        </ol>
      </div>
      <div class="glance more">
        <h2>More from the blog</h2>
        <ul>
          {others.map((o) => (<li><a href={o.file}>{o.title}</a><span>{o.date}</span></li>))}
        </ul>
      </div>
      <div class="glance ask">
        <h2>Got a stump?</h2>
        <p>Send photos and the details and we'll put a number on it in writing.</p>
        <a class="btn btn-primary" href="service-request.html#request" data-open-form>Request an estimate</a>
      </div>
    </aside>
  </div>
</section>

<section class="section" style="padding-top: 0">
  <div class="container">
  <div class="card closing">
    <h2>Getting a stump ground or removed?</h2>
    <p>Tell us about the job and anything you know is buried nearby — we'll take it from there.</p>
    <div class="btn-row">
      <a class="btn btn-primary btn-lg" href="service-request.html#request" data-open-form>Request Service</a>
      <a class="btn btn-outline btn-lg" href="booking.html">Book an OSC</a>
    </div>
  </div>
  </div>
</section>
</Site>
