---
import Site from '../layouts/Site.astro';
import '../styles/pages/faq-v2.css';
import Icon from '../components/v2/Icon.astro';
import { hero, groups, closing } from '../data/faq';
import { business } from '../data/site';

const SITE = 'https://spokanestumpgrinder.com/';
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': SITE + 'faq.html',
  url: SITE + 'faq.html',
  mainEntity: groups.flatMap((g) => g.items.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.plain ?? f.a },
  }))),
};
const total = groups.reduce((n, g) => n + g.items.length, 0);

const meta = {
  title: 'FAQ | Spokane Stump Grinder',
  description: 'Answers to the questions homeowners ask most about stump grinding and removal in Spokane, WA — pricing, scheduling, and how the work actually happens.',
  canonical: SITE + 'faq.html',
  og: { type: 'website', title: 'FAQ | Spokane Stump Grinder', description: 'Answers to the questions homeowners ask most about stump grinding and removal in Spokane, WA — pricing, scheduling, and how the work actually happens.', url: SITE + 'faq.html', image: SITE + 'images/about-stump-profile.jpg', site_name: business.name },
  twitterCard: 'summary_large_image',
  jsonld: [JSON.stringify(faqLd, null, 2)],
  active: 'faq.html',
};
---
<Site {...meta}>

  <!-- HERO -->
  <section class="faq-hero">
    <div class="container">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1>{hero.h1}</h1>
      <p class="lede">{hero.lede}</p>
      <div class="btn-row">
        <a class="btn btn-primary btn-lg" href={hero.primary.href}>{hero.primary.label} <Icon name="arrow-right" size={18} /></a>
        <a class="btn btn-outline btn-lg" href={hero.secondary.href}><Icon name="calendar-check" size={18} /> {hero.secondary.label}</a>
      </div>
      <nav class="jump" aria-label="Question topics">
        {groups.map((g) => (<a class="badge" href={`#${g.id}`}><Icon name={g.icon} size={14} /> {g.eyebrow} <span class="count">{g.items.length}</span></a>))}
      </nav>
    </div>
  </section>

  <!-- GROUPS -->
  {groups.map((g, i) => (
    <section class={`section faq-group${i % 2 ? ' section-muted' : ''}`} id={g.id}>
      <div class="container faq-grid">
        <div class="faq-head">
          <span class="icon-chip"><Icon name={g.icon} size={22} /></span>
          <p class="eyebrow">{g.eyebrow}</p>
          <h2>{g.h2}</h2>
          {g.lede && <p class="lede">{g.lede}</p>}
        </div>
        <div class="faq">
          {g.items.map((f) => (
            <details name={g.id}>
              <summary><h3>{f.q}</h3><Icon name="chevron-down" size={20} /></summary>
              <p set:html={f.a} />
            </details>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- CLOSING CTA -->
  <section class="section" style="padding-top: 0">
    <div class="container">
      <div class="card closing">
        <p class="eyebrow">{total} questions answered above</p>
        <h2>{closing.h2}</h2>
        <p class="lede">{closing.text}</p>
        <div class="btn-row">
          <a class="btn btn-primary btn-lg" href="service-request.html">Request an estimate</a>
          <a class="btn btn-outline btn-lg" href={`tel:${business.phoneHref}`}><Icon name="phone" size={18} /> Call or text {business.phoneDisplay}</a>
          <a class="btn btn-outline btn-lg" href="booking.html"><Icon name="calendar-check" size={18} /> Book an OSC</a>
        </div>
      </div>
    </div>
  </section>

</Site>
