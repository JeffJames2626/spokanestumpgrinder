---
import Site from '../layouts/Site.astro';
import '../styles/pages/contact-v2.css';
import Icon from '../components/v2/Icon.astro';
import { map, hero, reach, location, closing } from '../data/contact';
import { business } from '../data/site';

const SITE = 'https://spokanestumpgrinder.com/';
const contactLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  '@id': SITE + 'contact.html',
  url: SITE + 'contact.html',
  name: 'Contact Spokane Stump Grinder',
  mainEntity: {
    '@type': 'LocalBusiness',
    '@id': SITE + '#business',
    name: business.name,
    telephone: '+1-509-434-9554',
    email: business.email,
    address: { '@type': 'PostalAddress', streetAddress: business.street, addressLocality: 'Spokane', addressRegion: 'WA', postalCode: '99202', addressCountry: 'US' },
    hasMap: map.directions,
    contactPoint: [{ '@type': 'ContactPoint', telephone: '+1-509-434-9554', email: business.email, contactType: 'customer service', areaServed: 'US' }],
  },
};

const meta = {
  title: 'Contact Us | Spokane Stump Grinder',
  description: "Call, text, or email Spokane Stump Grinder — stump grinding and removal in Spokane, WA and the Coeur d'Alene region. 1908 E Mallon Ave, Spokane, WA 99202.",
  canonical: SITE + 'contact.html',
  og: { type: 'website', title: 'Contact Us | Spokane Stump Grinder', description: "Call, text, or email Spokane Stump Grinder — stump grinding and removal in Spokane, WA and the Coeur d'Alene region. 1908 E Mallon Ave, Spokane, WA 99202.", url: SITE + 'contact.html', image: SITE + 'images/about-stump-profile.jpg', site_name: business.name },
  twitterCard: 'summary_large_image',
  jsonld: [JSON.stringify(contactLd, null, 2)],
  active: 'contact.html',
};
---
<Site {...meta}>

  <!-- HERO -->
  <section class="ct-hero">
    <div class="container">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1>{hero.h1}</h1>
      <p class="lede">{hero.lede}</p>
      <div class="btn-row">
        <a class="btn btn-primary btn-lg" href={hero.primary.href}>{hero.primary.label} <Icon name="arrow-right" size={18} /></a>
        <a class="btn btn-outline btn-lg" href={hero.secondary.href}><Icon name="calendar-check" size={18} /> {hero.secondary.label}</a>
      </div>
    </div>
  </section>

  <!-- REACH US -->
  <section class="section section-muted" id="reach">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{reach.eyebrow}</p>
        <h2>{reach.h2}</h2>
        <p class="lede">{reach.lede}</p>
      </div>
      <div class="ways">
        {reach.ways.map((w) => (
          <article class="card way">
            <span class="icon-chip"><Icon name={w.icon} size={22} /></span>
            <h3>{w.title}</h3>
            {w.kind === 'phone' && <a class="big" href={`tel:${business.phoneHref}`}>{business.phoneDisplay}</a>}
            {w.kind === 'email' && <a class="big" href={`mailto:${business.email}`}>info@<wbr />spokanestumpgrinder.com</a>}
            {w.kind === 'form' && <a class="big" href={w.href}>{w.label} <Icon name="arrow-right" size={20} /></a>}
            <p>{w.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- LOCATION -->
  <section class="section" id="location">
    <div class="container loc-grid">
      <div class="loc-text">
        <div class="section-head">
          <p class="eyebrow">{location.eyebrow}</p>
          <h2>{location.h2}</h2>
          <p class="lede">{location.lede}</p>
        </div>
        <div class="card addr-card">
          <dl class="addr">
            <div class="addr-row">
              <span class="icon-chip"><Icon name="map-pin" size={18} /></span>
              <dt>Address</dt>
              <dd><address>{business.street}<br />{business.cityStateZip}</address></dd>
            </div>
            <div class="addr-row">
              <span class="icon-chip"><Icon name="phone" size={18} /></span>
              <dt>Call or text</dt>
              <dd><a href={`tel:${business.phoneHref}`}>{business.phoneDisplay}</a></dd>
            </div>
            <div class="addr-row">
              <span class="icon-chip"><Icon name="mail" size={18} /></span>
              <dt>Email</dt>
              <dd><a href={`mailto:${business.email}`}>info@<wbr />spokanestumpgrinder.com</a></dd>
            </div>
          </dl>
          <div class="addr-actions">
            <a class="btn btn-primary" href={map.directions} target="_blank" rel="noopener"><Icon name="navigation" size={16} /> Get directions</a>
            <a class="btn btn-outline" href={location.townsLink.href}>{location.townsLink.label} <Icon name="arrow-right" size={16} /></a>
          </div>
        </div>
      </div>
      <div class="card map-card">
        <iframe src={map.embedSrc} loading="lazy" allowfullscreen="" referrerpolicy="strict-origin-when-cross-origin" title="Spokane Stump Grinder on Google Maps"></iframe>
        <p class="map-foot"><Icon name="map-pin" size={16} /> {business.street}, {business.cityStateZip} &middot; <a href={map.directions} target="_blank" rel="noopener">Open in Google Maps</a></p>
      </div>
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section class="section" style="padding-top: 0">
    <div class="container">
      <div class="card closing">
        <h2>{closing.h2}</h2>
        <p class="lede">{closing.text}</p>
        <div class="btn-row">
          <a class="btn btn-primary btn-lg" href="service-request.html">Request service</a>
          <a class="btn btn-outline btn-lg" href={`tel:${business.phoneHref}`}><Icon name="phone" size={18} /> Call or text {business.phoneDisplay}</a>
          <a class="btn btn-outline btn-lg" href="booking.html"><Icon name="calendar-check" size={18} /> Book an OSC</a>
        </div>
      </div>
    </div>
  </section>

</Site>
