const headline = 'This Is What a Dull Stump Grinder Tooth Looks Like';
const description = 'One tooth, two angles, on a stump grinder sitting out front at a Spokane-area rental yard. What a worn carbide tooth means for your rental day, and the quick look to take before you tow one home to Cheney, Airway Heights or anywhere in Spokane County.';
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': URL,
  mainEntityOfPage: URL,
  headline,
  description,
  image: [SITE + 'images/rental-grinder-tooth-worn-edge.jpg', SITE + 'images/rental-grinder-tooth-worn-pocket.jpg'],
  datePublished: '2026-10-20',
  dateModified: '2026-10-20',
  author: { '@type': 'Organization', name: 'Spokane Stump Grinder' },
  publisher: { '@type': 'Organization', '@id': SITE + '#business', name: 'Spokane Stump Grinder' },
  about: [{ '@type': 'Thing', name: 'Stump grinder rental' }, { '@type': 'Place', name: 'Spokane, WA' }, { '@type': 'Place', name: 'Cheney, WA' }, { '@type': 'Place', name: 'Airway Heights, WA' }],
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'How can I tell if a stump grinder tooth is dull?', acceptedAnswer: { '@type': 'Answer', text: "Look at the carbide tip. A sharp tooth ends in a defined edge. A dull one is rounded over and polished, like a worn pebble. Once the tip is rounded to about a 1/16-inch radius it is done cutting, even though it still looks like a tooth and still spins." } },
    { '@type': 'Question', name: 'Do rental yards sharpen stump grinder teeth?', acceptedAnswer: { '@type': 'Answer', text: "Not routinely. Rental counters check that the machine starts and the wheel turns. Teeth are a wear item, often billed per tooth outside the damage waiver, so whether the set on the machine is sharp is yours to check before you sign." } },
    { '@type': 'Question', name: 'What if the teeth are dull when I pick up the rental?', acceptedAnswer: { '@type': 'Answer', text: "Ask the counter to swap or sharpen them before you leave, or ask for a different machine. A small-engine grinder with dull teeth polishes a hardwood stump instead of cutting it, and the day can end with the stump still in the ground. If you are renting from Cheney or Airway Heights, that conversation is a lot easier at the counter than after the tow home." } },
  ],
