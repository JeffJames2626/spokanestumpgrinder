const meta = {
  title: 'Dull Stump Grinder Tooth, Up Close | Spokane Stump Grinder',
  description,
  canonical: URL,
  og: { type: 'article', title: headline, description, url: URL, image: SITE + 'images/rental-grinder-tooth-worn-edge.jpg', site_name: 'Spokane Stump Grinder' },
  twitterCard: 'summary_large_image',
  jsonld: [JSON.stringify(ld), JSON.stringify(faqLd)],
