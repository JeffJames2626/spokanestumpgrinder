{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd astro && npm ci",
  "buildCommand": "cd astro && npm run build",
  "outputDirectory": "astro/dist",
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/lead.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  }
}
